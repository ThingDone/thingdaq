{
  "name": "teensy-daq",
  "protocol_version": 1,
  "byte_order": "little",
  "magic": 3735928559,
  "scalar_types": {
    "u8": {"width": 1, "signed": false},
    "u16": {"width": 2, "signed": false},
    "u32": {"width": 4, "signed": false},
    "u64": {"width": 8, "signed": false}
  },
  "compatibility": {
    "unknown_version": "reject the candidate before interpreting its payload and make no state change",
    "unknown_frame_kind": "reject the candidate before waiting for its declared payload and make no state change",
    "unknown_command_kind": "command kinds are request frame kinds; reject an unknown request frame kind",
    "unknown_checksum": "reject the candidate before waiting for its declared payload",
    "reserved_fields": "all reserved scalar fields and reserved request-mask bits are zero on send and rejected when nonzero",
    "unknown_capability_bits": "reserved in protocol v1 and rejected in an INFO response"
  },
  "header": {
    "size": 44,
    "encoding": "fixed-width unsigned integers in little-endian byte order",
    "fields": [
      {"name": "magic", "offset": 0, "type": "u32"},
      {"name": "version", "offset": 4, "type": "u8"},
      {"name": "kind", "offset": 5, "type": "u8"},
